root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120
ij_any_keep_blank_lines_in_code = 1

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[*.java]
ij_java_class_count_to_use_import_on_demand = 999
ij_java_class_count_to_use_import_on_demand = 999
